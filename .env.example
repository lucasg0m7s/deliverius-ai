# Copy to .env. The defaults work with the local docker-compose.yml.
# Free-form label logged at startup (development, ci, demo, production).
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://deliverius:deliverius@localhost:5433/deliverius
DATABASE_CONNECT_TIMEOUT_SECONDS=3.0
# Connection pool: steady connections, extra connections under load, and the longest wait for a free one.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5.0
# Server-side limits, applied to every connection: query run time, wait for a lock, idle open transaction.
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Upper bound for the whole /health check; keep it below the container HEALTHCHECK timeout.
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# Embedding model of the policy search, downloaded by `python -m deliverius.cli retrieval fetch-model`.
RETRIEVAL_MODEL_DIR=models/multilingual-e5-small
# Cosine similarity (0 to 1) under which a search result is "not reliable". Provisional until measured.
RETRIEVAL_MIN_SIMILARITY=0.85
# When a result is reliable: `similarity_only` (best similarity >= the threshold) or
# `both_lists_and_similarity` (a chunk in both lists as well). Provisional until measured.
RETRIEVAL_RELIABILITY_RULE=similarity_only
# CPU threads of the ONNX session; keep it low on a shared host.
RETRIEVAL_THREADS=1

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# json (production) or console (readable, for development).
LOG_FORMAT=console

# LLM roles: `provider:model`, with provider one of gemini, groq, ollama or anthropic.
# A role without a fallback uses an empty value (LLM_AGENT_FALLBACK=).
LLM_AGENT_MODEL=gemini:gemini-3.5-flash-lite
LLM_AGENT_FALLBACK=groq:openai/gpt-oss-120b
LLM_WRITER_MODEL=gemini:gemini-3.5-flash-lite
LLM_WRITER_FALLBACK=groq:openai/gpt-oss-20b
LLM_CUSTOMER_SIM_MODEL=groq:openai/gpt-oss-120b
LLM_JUDGE_MODEL=groq:openai/gpt-oss-120b
LLM_DATAGEN_MODEL=gemini:gemini-3.5-flash-lite
# Writes the holdout test set of the dataset: keep it on another provider than LLM_DATAGEN_MODEL.
LLM_DATAGEN_HOLDOUT_MODEL=groq:openai/gpt-oss-120b

# Provider keys are optional: the API starts without them. A role needs the key of its provider.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Hugging Face token with write access. Only for publishing the synthetic dataset.
HF_TOKEN=

# Our own daily and per-minute ceilings per provider, below the provider quota. Unset means unlimited
# (Ollama); zero blocks every real call (Anthropic). Defaults are 80% of the free-tier quota checked on 2026-11-08.
LLM_GEMINI_DAILY_REQUESTS=400
LLM_GEMINI_DAILY_TOKENS=2000000
LLM_GEMINI_RPM=12
LLM_GROQ_DAILY_REQUESTS=800
LLM_GROQ_DAILY_TOKENS=150000
LLM_GROQ_RPM=25
LLM_ANTHROPIC_DAILY_REQUESTS=0
LLM_ANTHROPIC_DAILY_TOKENS=0

# Comma-separated providers billed in real money (the real cost is zero for the others).
LLM_PAID_PROVIDERS=
